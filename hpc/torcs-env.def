Bootstrap: docker
From: ubuntu:22.04

%environment
    export TORCS_HOME=/usr/local/torcs
    export PATH=/usr/local/torcs/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/torcs/lib:$LD_LIBRARY_PATH

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y git build-essential pkg-config \
        libgl1-mesa-dev libglu1-mesa-dev libplib-dev libopenal-dev libalut-dev \
        libvorbis-dev libxxf86vm-dev libxi-dev libxmu-dev libxrender-dev \
        libxrandr-dev libpng-dev zlib1g-dev freeglut3-dev libglib2.0-dev \
        unzip xvfb python3
    rm -rf /var/lib/apt/lists/*
    cd /opt && git clone https://github.com/fmirus/torcs-1.3.7.git torcs-src
    cd /opt/torcs-src && ./configure --prefix=/usr/local/torcs
    make -j16 || make
    make install && make datainstall
    echo /usr/local/torcs/lib > /etc/ld.so.conf.d/torcs.conf && ldconfig
    cd /tmp && git clone --depth 1 https://github.com/ibm-ai-racing/racing-league.git
    unzip -o racing-league/installation/docker/image_source/scr_server.zip \
        -d /usr/local/torcs/share/games/torcs/drivers/
    rm -rf /usr/local/torcs/share/games/torcs/drivers/__MACOSX /tmp/racing-league
    find /usr/local/torcs/share/games/torcs/drivers/ -name .DS_Store -delete
